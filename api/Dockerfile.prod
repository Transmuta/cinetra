# Imagem de produção da API (Phoenix + Ash) — build multi-stage → mix release.
# Difere do Dockerfile.dev: compila um release imutável (não roda mix/phx.server), sem
# ferramentas de build no runtime, como usuário não-root.

# ---- build ----
FROM elixir:1.20.1-otp-29@sha256:19ee088049ac64d76779c7789745a3a119e49abd70bbc74b0e3b95ab4a14842b AS build

RUN apt-get update -y \
  && apt-get install -y --no-install-recommends build-essential git \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV=prod \
    LANG=C.UTF-8

WORKDIR /app

# Deps primeiro (camada cacheável). Só as de prod.
COPY mix.exs mix.lock ./
RUN mix deps.get --only prod

COPY config config
RUN mix deps.compile

COPY priv priv
COPY lib lib
RUN mix compile

# runtime.exs vai junto no release; monta a config a partir das envs no boot.
RUN mix release

# ---- runtime ----
#
# **O Debian daqui tem de ser o MESMO do builder acima.** A ERTS é compilada nativamente lá e
# copiada para cá; se o runtime for mais velho, o `beam.smp` não encontra os símbolos da glibc
# contra a qual foi ligado e a imagem **não executa uma única instrução**:
#
#   beam.smp: /lib/x86_64-linux-gnu/libm.so.6: version `GLIBC_2.38' not found
#
# Medido em 2026-08-06, com as duas bases pregadas por digest (ou seja, o CI produzia a mesma
# imagem quebrada): `elixir:1.20.1-otp-29` é Debian 13 trixie, **glibc 2.41**; o
# `debian:bookworm-slim` que estava aqui é Debian 12, **glibc 2.36**. A imagem subiu no GHCR,
# passou em todo gate do CI e derrubou a HML — o `migrate` saiu com `exit 1` e o log do deploy
# não menciona glibc, banco nem migration.
#
# Pin por digest NÃO protege contra isto: protege contra a base mudar sozinha, e o problema aqui é
# as duas mudarem em ritmos diferentes. Ao subir a versão do Elixir, confira o Debian da imagem
# nova (`cat /etc/os-release`) e traga esta linha junto. O gate que pega o esquecimento é o passo
# de smoke do job `imagem` no CI, que **roda** a imagem construída em vez de só construí-la.
FROM debian:trixie-slim@sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258 AS app

# `curl` existe por um motivo só: o `healthcheck` do serviço `api` em `compose.dokploy.yml`
# (R-A7). A imagem não tinha NENHUM cliente HTTP — e sem healthcheck de Docker o
# `restart: unless-stopped` nunca dispara para um processo travado que não morreu, porque o
# daemon segue reportando `Up`. A alternativa sem tocar na imagem seria `bin/api rpc`, que sobe
# uma BEAM inteira a cada checagem; caro numa máquina de 2 vCPU onde o build já mede 90% (D-21).
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends libstdc++6 openssl libncurses6 ca-certificates curl \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8 \
    MIX_ENV=prod \
    PHX_SERVER=true

WORKDIR /app
RUN useradd --create-home --uid 1000 app && chown app:app /app
COPY --from=build --chown=app:app /app/_build/prod/rel/api ./

USER app
EXPOSE 4000

# O serviço `migrate` do compose sobrescreve o comando para rodar `Api.Release.setup()`.
CMD ["bin/api", "start"]
