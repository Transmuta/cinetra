# Imagem de produção da API (Phoenix + Ash) — build multi-stage → mix release.
# Difere do Dockerfile.dev: compila um release imutável (não roda mix/phx.server), sem
# ferramentas de build no runtime, como usuário não-root.

# ---- build ----
FROM elixir:1.18.4-otp-27@sha256:1f8c9923c1c2ff2830e772852dd65e1263d424a50a2651ce757c03eedff3f56e AS build

RUN apt-get update -y \
  && apt-get install -y --no-install-recommends build-essential git \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV=prod \
    LANG=C.UTF-8

WORKDIR /app

# Deps primeiro (camada cacheável). Só as de prod.
COPY mix.exs mix.lock ./
RUN mix deps.get --only prod

COPY config config
RUN mix deps.compile

COPY priv priv
COPY lib lib
RUN mix compile

# runtime.exs vai junto no release; monta a config a partir das envs no boot.
RUN mix release

# ---- runtime ----
FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS app

# `curl` existe por um motivo só: o `healthcheck` do serviço `api` em `compose.dokploy.yml`
# (R-A7). A imagem não tinha NENHUM cliente HTTP — e sem healthcheck de Docker o
# `restart: unless-stopped` nunca dispara para um processo travado que não morreu, porque o
# daemon segue reportando `Up`. A alternativa sem tocar na imagem seria `bin/api rpc`, que sobe
# uma BEAM inteira a cada checagem; caro numa máquina de 2 vCPU onde o build já mede 90% (D-21).
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends libstdc++6 openssl libncurses6 ca-certificates curl \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8 \
    MIX_ENV=prod \
    PHX_SERVER=true

WORKDIR /app
RUN useradd --create-home --uid 1000 app && chown app:app /app
COPY --from=build --chown=app:app /app/_build/prod/rel/api ./

USER app
EXPOSE 4000

# O serviço `migrate` do compose sobrescreve o comando para rodar `Api.Release.setup()`.
CMD ["bin/api", "start"]
